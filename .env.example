# ─── Supabase Configuration ───────────────────────────────────────────────────
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret-key
JWT_SECRET=generate-a-strong-random-secret-here

# ─── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
# These are filled in AFTER the WhatsApp Business phone is verified on Meta.
# The application works completely without these — use the Bot Simulator to test.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Webhook Verify Token — you choose this value, then enter same value in Meta Dashboard
WHATSAPP_VERIFY_TOKEN=maa_durga_verify_token_2026

# ─── n8n Workflow ─────────────────────────────────────────────────────────────
# The production webhook URL from your n8n instance (e.g. https://your-n8n.app/webhook/xxxx)
N8N_WEBHOOK_URL=

# ─── App Config ───────────────────────────────────────────────────────────────
# Your deployed app URL (used to generate upload links sent via WhatsApp)
PUBLIC_APP_URL=https://your-app.onrender.com

# How long (minutes) a WhatsApp-generated upload link stays valid
UPLOAD_TOKEN_EXPIRY_MINUTES=60
